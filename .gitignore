# ==========================================
# NAMMA SPACE - Git Ignore Rules
# Excludes heavy datasets, models, checkpoints, and video/images
# ==========================================

# OS & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Heavy Raw Data & Video Files
namma-space-project/input-videos/*
!namma-space-project/input-videos/.gitkeep
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.AVI
*.m4v
*.M4V
*.mkv
*.MKV

# Heavy Extracted Frames & Datasets
namma-space-project/.work/
.work/
**/images/
**/images_2/
**/images_4/
**/images_8/
*.png
*.jpg
*.jpeg
*.heic
*.raw

# Training Checkpoints, Logs & Large Weights
*.ckpt
*.pt
*.pth
*.bin
*.log
training.log
*.db
*.db-journal
nerfstudio_models/
colmap/

# Large 3D Point Clouds & Splats (>50MB)
*.splat
namma-space-project/.work/**
namma-space-project/output-models/*/*.ply
namma-space-project/output-models/*/*.splat

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
.out/

# Temporary caches
tmp/
torch_cache/
